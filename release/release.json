{
  "product": "ORBI Energy Swarm",
  "packageName": "orbi-energy-swarm",
  "version": "0.2.0-beta.1",
  "channel": "beta",
  "releaseCandidateEligible": false,
  "targetSurfaces": [
    "web",
    "android"
  ],
  "automatedCertification": {
    "repositoryCI": true,
    "responsiveContracts": true,
    "infiniteLargeRange": true,
    "accessibilityContracts": true,
    "androidPerformanceSoftwareMatrix": true,
    "pwaDistributionContracts": true,
    "androidPackagingContracts": true
  },
  "webDistribution": {
    "deploymentTarget": "github-pages",
    "installability": "pwa",
    "basePath": "/orbi-energy.swarm/",
    "serviceWorkerPolicy": "build-sha-versioned-fail-open"
  },
  "androidDistribution": {
    "strategy": "capacitor-8",
    "nativePackaging": "capacitor-local-bundle",
    "applicationId": "com.orbiecosystem.energyswarm",
    "minSdk": 24,
    "compileSdk": 36,
    "targetSdk": 36,
    "pipeline": "github-actions-debug-apk",
    "signing": "external-secrets-required-for-release",
    "requirement": "Complete real-device thermal/battery/ergonomics validation and external signing before RC promotion."
  },
  "manualBlockers": [
    {
      "id": "issue-4-visual-certification",
      "issue": 4,
      "category": "visual-responsive",
      "requirement": "Human visual certification across supported viewport classes."
    },
    {
      "id": "issue-5-infinite-playfeel",
      "issue": 5,
      "category": "gameplay-balance",
      "requirement": "Manual Infinite Swarm difficulty and play-feel validation."
    },
    {
      "id": "es-11-real-device",
      "category": "android-hardware",
      "requirement": "Real-device thermal, sustained battery, browser chrome, ergonomics and OEM GPU/driver validation."
    }
  ],
  "pendingReleaseEngineering": [
    "release-candidate-certification"
  ]
}
